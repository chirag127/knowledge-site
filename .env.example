# knowledge.oriz.in — public env (browser-safe). Copy to .env, populate.
# Never commit real values. PUBLIC_* are shipped to the browser by design.

# Clerk (auth) — gates ONLY the personal "shelf"; public content is never gated.
# One Clerk org for all *.oriz.in → cross-subdomain SSO by default.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Firebase (Firestore ONLY — Clerk owns auth). Shared oriz-in project.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=auth.oriz.in
PUBLIC_FIREBASE_PROJECT_ID=oriz-app
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Content source (build-time only, not shipped). Absolute path to the OKF knowledge dir.
KNOWLEDGE_SRC=C:/d/oriz/knowledge
