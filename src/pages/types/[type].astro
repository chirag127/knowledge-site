---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { callNumber } from '../../lib/callNumber'

export async function getStaticPaths() {
  const concepts = await getCollection('concepts')
  const types = new Set<string>()
  for (const c of concepts) types.add((c.data as any).type || 'other')
  return [...types].map((type) => ({ params: { type }, props: { type } }))
}

const { type } = Astro.props
const allConcepts = await getCollection('concepts')
const concepts = allConcepts
  .filter((c) => ((c.data as any).type || 'other') === type)
  .sort((a, b) => String((b.data as any).timestamp || '').localeCompare(String((a.data as any).timestamp || '')))
const classLetters = callNumber(type, type).split(' ')[0]
---

<BaseLayout title={`${type} — Card Catalogue`}>
  <div class="home">
    <section class="drawer-hero">
      <span class="eyebrow">Drawer {classLetters} · {concepts.length} cards</span>
      <h1 style="text-transform: capitalize;">{type}</h1>
      <p class="thesis"><a href="/">← back to the catalogue</a></p>
    </section>

    <div class="drawer-face">
      <div class="card-stack">
        {concepts.map((c) => {
          const d = c.data as any
          const call = callNumber(d.type || 'other', c.id)
          return (
            <a href={`/${c.id}`} class="card">
              <div class="card-line">
                <span class="call-tab">{call}</span>
                {d.timestamp && <span class="stamp">{String(d.timestamp).slice(0, 10)}</span>}
              </div>
              <div class="card-title">{d.title || c.id.split('/').pop()}</div>
              {d.description && <p class="card-desc">{d.description}</p>}
            </a>
          )
        })}
      </div>
    </div>
  </div>
</BaseLayout>
