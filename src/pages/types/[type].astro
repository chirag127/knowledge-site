---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const concepts = await getCollection('concepts')
  const types = new Set<string>()
  for (const c of concepts) types.add((c.data as any).type || 'other')
  return [...types].map(type => ({ params: { type }, props: { type } }))
}

const { type } = Astro.props
const allConcepts = await getCollection('concepts')
const concepts = allConcepts
  .filter(c => ((c.data as any).type || 'other') === type)
  .sort((a, b) => String((b.data as any).timestamp || '').localeCompare(String((a.data as any).timestamp || '')))
---

<BaseLayout title={`${type} — knowledge.oriz.in`}>
  <main style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem;">
    <p style="color: var(--muted); margin-bottom: 0.5rem;"><a href="/" style="color: inherit;">← knowledge.oriz.in</a></p>
    <h1 style="font-family: var(--font-head);">{type} <span style="color: var(--muted); font-weight: 400;">({concepts.length})</span></h1>

    <ul style="list-style: none; padding: 0; margin-top: 1.5rem;">
      {concepts.map(c => {
        const d = c.data as any
        return (
          <li style="padding: 0.75rem 0; border-bottom: 1px solid var(--rule);">
            <a href={`/${c.id}`} style="text-decoration: none; color: inherit;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
                <strong style="font-family: var(--font-head); font-weight: 600; font-size: 1.0625rem;">{d.title || c.id.split('/').pop()}</strong>
                <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); white-space: nowrap;">{String(d.timestamp || '').slice(0, 10)}</span>
              </div>
              {d.description && <div style="color: var(--muted); font-size: 0.9375rem; margin-top: 0.25em;">{d.description}</div>}
            </a>
          </li>
        )
      })}
    </ul>
  </main>
</BaseLayout>
