---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { callNumber } from '../lib/callNumber'

const concepts = await getCollection('concepts')

const byType: Record<string, number> = {}
for (const c of concepts) {
  const t = (c.data as any).type || 'other'
  byType[t] = (byType[t] || 0) + 1
}

const CATEGORY_META: Record<string, string> = {
  decision: 'Locked choices, dated, with the reasoning that fixed them.',
  rule: 'Non-negotiable constraints. Read before you break one.',
  runbook: 'Step-by-step procedures. Read before you run.',
  service: 'Third-party services with free-tier numbers + adoption status.',
  glossary: 'House vocabulary and shorthand.',
  reference: 'External docs, papers, archives.',
  index: 'Section indexes and maps.',
  security: 'Secrets, auth, and safety disciplines.',
  other: 'Everything not yet filed under a heading.',
}

const drawers = Object.entries(byType).sort((a, b) => b[1] - a[1])

const recent = [...concepts]
  .sort((a, b) => String((b.data as any).timestamp || '').localeCompare(String((a.data as any).timestamp || '')))
  .slice(0, 10)
---

<BaseLayout title="Card Catalogue — knowledge.oriz.in">
  <div class="home">
    <section class="drawer-hero">
      <span class="eyebrow">Catalogue · Open Knowledge Format · card {concepts.length}</span>
      <h1>Every decision I've made, <em>filed</em> and cross-referenced.</h1>
      <p class="thesis">
        A working engineer's second brain kept the way a library keeps its holdings —
        one card per concept, each with a call number, a heading, and the rule of thumb
        that put it there. Pull a drawer, read the card, follow the cross-reference.
      </p>
      <span class="rod-count">
        <b>{concepts.length}</b> cards on the rod · {drawers.length} drawers
      </span>
    </section>

    <span class="guide-tab">The drawers</span>
    <div class="drawer-face">
      <div class="drawer-grid">
        {drawers.map(([t, n]) => (
          <a href={`/types/${t}/`} class="drawer">
            <span class="call-tab">{callNumber(t, t).split(' ')[0]} · {n}</span>
            <div class="d-type">{t}</div>
            <p class="d-desc">{CATEGORY_META[t] || 'Concept cards.'}</p>
          </a>
        ))}
      </div>
    </div>

    <span class="guide-tab">Recently filed</span>
    <div class="drawer-face">
      <div class="card-stack" id="recent-stack">
        {recent.map((c) => {
          const d = c.data as any
          const call = callNumber(d.type || 'other', c.id)
          return (
            <a href={`/${c.id}`} class="card">
              <div class="card-line">
                <span class="call-tab">{call}</span>
                {d.timestamp && <span class="stamp">{String(d.timestamp).slice(0, 10)}</span>}
              </div>
              <div class="card-title">{d.title || c.id.split('/').pop()}</div>
              {d.description && <p class="card-desc">{d.description}</p>}
            </a>
          )
        })}
      </div>
    </div>
  </div>

  <script>
    // Orchestrated riffle: cards settle into the stack, staggered, once, on load.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const stack = document.getElementById('recent-stack')
    if (stack && !reduce) {
      stack.classList.add('card-riffle')
      ;[...stack.children].forEach((el, i) => {
        ;(el as HTMLElement).style.animationDelay = `${i * 55}ms`
      })
    } else if (stack) {
      ;[...stack.children].forEach((el) => ((el as HTMLElement).style.opacity = '1'))
    }
  </script>
</BaseLayout>
