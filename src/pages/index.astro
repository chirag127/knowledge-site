---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const concepts = await getCollection('concepts')

// Group by top-level type
const byType: Record<string, { count: number; latest: any[] }> = {}
for (const c of concepts) {
  const t = (c.data as any).type || 'other'
  byType[t] ??= { count: 0, latest: [] }
  byType[t].count++
  byType[t].latest.push(c)
}
for (const t of Object.keys(byType)) {
  byType[t].latest.sort((a, b) => String((b.data as any).timestamp || '').localeCompare(String((a.data as any).timestamp || ''))).slice(0, 3)
}

const CATEGORY_META: Record<string, string> = {
  decision: 'Locked architectural and operational choices with rationale.',
  rule: 'Non-negotiable constraints and disciplines.',
  runbook: 'Step-by-step procedures — read before running.',
  service: 'Third-party services with free-tier numbers and adoption status.',
  glossary: 'Family vocabulary and shorthand.',
  reference: 'External docs, papers, and archives.',
  index: 'Section indexes.',
}
---

<BaseLayout title="knowledge.oriz.in">
  <main style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem;">
    <div class="frontmatter-hero">
      <strong>type:</strong> knowledge-bundle<br />
      <strong>format:</strong> okf-v0.2<br />
      <strong>concepts:</strong> {concepts.length}<br />
      <strong>author:</strong> chirag127<br />
      <strong>license:</strong> MIT<br />
      <strong>source:</strong> <a href="https://github.com/chirag127/workspace" style="color: var(--accent);">github.com/chirag127/workspace</a>
    </div>

    <h1 style="font-family: var(--font-head); font-size: clamp(2.5rem, 5vw, 3.75rem); margin-top: 1rem;">The library.</h1>
    <p style="font-size: 1.125rem; color: var(--muted); max-width: 40rem;">
      {concepts.length} concept files backing a personal engineering practice.
      Decisions, rules, runbooks, services. Written to be re-read.
      Structured in <a href="https://github.com/GoogleCloudPlatform/knowledge-catalog" style="color: var(--accent);">Open Knowledge Format</a>.
    </p>

    <div class="category-grid">
      {Object.entries(byType).sort((a, b) => b[1].count - a[1].count).map(([t, info]) => (
        <a href={`/types/${t}/`} class="category-card">
          <span class="count">{info.count} files</span>
          <h3>{t}</h3>
          <p>{CATEGORY_META[t] || 'Concept files.'}</p>
        </a>
      ))}
    </div>

    <section style="margin-top: 3rem;">
      <h2 style="font-family: var(--font-head); border-bottom: 1px solid var(--rule); padding-bottom: 0.3em;">Recently updated</h2>
      <ul style="list-style: none; padding: 0; margin-top: 1rem;">
        {concepts
          .sort((a, b) => String((b.data as any).timestamp || '').localeCompare(String((a.data as any).timestamp || '')))
          .slice(0, 12)
          .map(c => (
            <li style="padding: 0.75rem 0; border-bottom: 1px solid var(--rule);">
              <a href={`/${c.id}`} style="text-decoration: none; color: inherit; display: flex; justify-content: space-between; gap: 1rem; align-items: baseline;">
                <span>
                  <strong style="font-family: var(--font-head); font-weight: 600;">{(c.data as any).title || c.id}</strong>
                  <span style="color: var(--muted); font-size: 0.9rem; margin-left: 0.5rem;">— {(c.data as any).description || ''}</span>
                </span>
                <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); white-space: nowrap;">{String((c.data as any).timestamp || '').slice(0, 10)}</span>
              </a>
            </li>
          ))}
      </ul>
    </section>
  </main>
</BaseLayout>
